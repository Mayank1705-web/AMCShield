# AMCShield local configuration template.
# Copy to `.env` and fill in the values:   copy .env.example .env
# `.env` is git-ignored. Never commit real secrets.

ENVIRONMENT=development
APP_NAME=AMCShield API
APP_VERSION=1.0.0
API_PREFIX=/api

# Comma-separated list of browser origins allowed to call the API.
# Wildcards are rejected because cookies are sent with credentials.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Session cookie ---------------------------------------------------
# REQUIRED. Minimum 32 characters.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Must be true when ENVIRONMENT=production (HTTPS only).
SESSION_HTTPS_ONLY=false
# Session lifetime in seconds (minimum 300).
SESSION_MAX_AGE=28800

# --- Local administrator ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@amcshield.local
# Password for the bootstrap administrator. Leave empty to disable it.
ADMIN_PASSWORD=

# --- GitHub OAuth (optional) -----------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback
GITHUB_SCOPE=read:user user:email
GITHUB_STATE_MAX_AGE=600

# --- Account provisioning --------------------------------------------
APP_BASE_URL=http://127.0.0.1:8000
INVITATION_MINUTES=60
PASSWORD_RESET_MINUTES=30

# --- Login protection -------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- SMTP (optional, used for invitation e-mails) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AMCShield

# --- Paths (normally leave unset; defaults are relative to the repo) ---
# FRONTEND_DIR=
# SRC_DIR=
# RESULTS_DIR=
# CHECKPOINTS_DIR=
# DATA_DIR=
